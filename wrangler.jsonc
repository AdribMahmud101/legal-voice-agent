{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker-entry.ts",
	"name": "legal-voice-agent",
	"compatibility_date": "2026-09-24",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "legal-voice-agent"
		}
	],
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "legal-voice-agent-opennext-cache"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "legal-voice-db",
			"database_id": "cd6143ac-cfe9-4d92-a0fa-7e44753334b2"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"vars": {
		"DEEPGRAM_API_KEY": "",
		"GROQ_API_KEY": "",
		"SONIOX_API_KEY": "",
		"STT_MODEL": "nova-3-general",
		"STT_LANGUAGE": "bn",
		"LLM_MODEL": "qwen/qwen3.8-27b",
		"LLM_PROVIDER_URL": "https://api.groq.com/openai/v1",
		"LLM_PROXY_URL": "/api/llm",
		"TTS_PROVIDER": "soniox",
		"TTS_VOICE_ID": "Priya",
		"TTS_LANGUAGE": "bn"
	}
}